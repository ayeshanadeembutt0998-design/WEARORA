# ---------- Server ----------
NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:5173
SERVER_PUBLIC_URL=http://localhost:5000

# ---------- MongoDB Atlas ----------
MONGODB_URI="mongodb+srv://<username>:<password>@<cluster-url>/<database>"

# ---------- Auth ----------
JWT_SECRET=replace_with_a_secure_random_secret
JWT_EXPIRES_IN=1d
JWT_REMEMBER_EXPIRES_IN=30d
COOKIE_SAMESITE=lax

# ---------- Seeded Admin ----------
ADMIN_NAME=Wearora Admin
ADMIN_EMAIL=your-admin-email@example.com
ADMIN_PASSWORD=replace_with_a_secure_admin_password
ADMIN_MOBILE=03XXXXXXXXX

# ---------- OTP ----------
OTP_EXPIRY_SECONDS=120
OTP_RESEND_SECONDS=60
OTP_MAX_ATTEMPTS=5

# ---------- Store Rules ----------
CURRENCY=PKR
CURRENCY_SYMBOL=Rs.
DELIVERY_CHARGE=250
FREE_DELIVERY_THRESHOLD=5000
STORE_PICKUP_ENABLED=true
LOW_STOCK_THRESHOLD=5
MAX_POS_DISCOUNT_PERCENT=10
RETURN_WINDOW_DAYS=14

# ---------- Firebase Admin ----------
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_CLIENT_EMAIL=your-firebase-service-account-email
FIREBASE_PRIVATE_KEY="your-firebase-private-key"

# ---------- SMTP (Nodemailer) ----------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-google-app-password
EMAIL_FROM="Wearora <your-email@gmail.com>"
EMAIL_TRANSPORT=smtp